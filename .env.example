DATABASE_URL=postgresql://net:net@localhost:5432/net
REDIS_URL=redis://localhost:6379
DATABASE_POOL_MAX=10
DATABASE_APPLICATION_NAME=net-api
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_QUERY_TIMEOUT_MS=15000
DATABASE_STATEMENT_TIMEOUT_MS=10000
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=0
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
TRUST_CHATGPT_IDENTITY_HEADERS=false
LOG_FORMAT=pretty
# Set an OTLP/HTTP endpoint to enable traces and metrics, for example http://localhost:4318.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=net-api
OTEL_TRACES_SAMPLER_ARG=0.1
API_REQUESTS_PER_MINUTE=600
API_REQUEST_BURST=120
API_MAX_ACTIVE_PER_IP=30
API_MAX_ACTIVE_GLOBAL=1000
API_MAX_TRACKED_IPS=50000
SOCKET_MAX_CONNECTIONS_PER_ACTOR=5
SOCKET_ALLOW_NO_ORIGIN=false
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_MAX_REQUESTS_PER_SOCKET=1000
UPLOAD_DIR=.data/uploads
STORAGE_DRIVER=local
# Production multi-host: STORAGE_DRIVER=s3 and configure an S3-compatible bucket.
# S3_BUCKET=net-assets
# S3_REGION=ap-southeast-1
# S3_ENDPOINT=
# S3_PREFIX=net-assets
# S3_FORCE_PATH_STYLE=false
# Prefer workload identity/IAM roles. Local S3-compatible services may require these:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
ASSET_URL_TTL=10m
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001/chat

{
  "name": "@net/workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm build:packages && concurrently -k -n web,api -c blue,magenta \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "pnpm --filter @net/web dev",
    "dev:api": "pnpm --filter @net/api dev",
    "build:packages": "pnpm --filter @net/pigment build && pnpm --filter @net/database build",
    "build": "pnpm build:packages && pnpm --filter @net/api build && pnpm --filter @net/web build",
    "build:web": "pnpm --filter @net/pigment build && pnpm --filter @net/web build",
    "start": "concurrently -k -n web,api -c blue,magenta \"pnpm start:web\" \"pnpm start:api\"",
    "start:web": "pnpm --filter @net/web start",
    "start:api": "pnpm --filter @net/api start",
    "lint": "pnpm --filter @net/web lint && pnpm --filter @net/api lint",
    "check:infra": "node scripts/validate-nginx.mjs && AUTH_JWT_SECRET=local-compose-validation-secret-32bytes NEON_AUTH_BASE_URL=http://localhost:9999 NEON_AUTH_COOKIE_SECRET=local-compose-cookie-secret-32bytes docker compose config --quiet",
    "check:i18n": "node scripts/check-i18n.mjs",
    "security:audit": "pnpm audit --prod",
    "clean": "node scripts/clean-generated.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @net/database db:generate",
    "db:migrate": "pnpm --filter @net/database db:migrate",
    "db:studio": "pnpm --filter @net/database db:studio",
    "test:e2e": "playwright test --reporter=list"
  },
  "devDependencies": {
    "@net/database": "workspace:*",
    "@net/pigment": "workspace:*",
    "@playwright/test": "1.62.1",
    "concurrently": "9.2.1",
    "socket.io-client": "4.8.3",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "@nestjs/config>lodash": "4.18.1"
    }
  },
  "type": "module"
}
